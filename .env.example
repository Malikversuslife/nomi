NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional and server-only. Do not expose this to browser code.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional server-only AI provider values. Do not expose these to browser code.
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_MODEL=gpt-4o-mini
# NOMI_AI_TIMEOUT_MS=8000
# NOMI_AI_DISABLED=false

# Optional server-only secret used to encrypt generated practice question payloads.
# Required before AI-generated questions can be shown to learners without persisting them.
# NOMI_QUESTION_TOKEN_SECRET=replace-with-at-least-32-random-characters
